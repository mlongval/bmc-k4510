10 REM BMC-K4510 EHBASIC SELF-TEST. RUN "TEST.BAS": EVERY CHECK IS SILENT UNLESS IT FAILS.
20 N=0:F=0
30 REM ---- ARITHMETIC
40 C=(6*7=42):GOSUB 1000
50 C=(7/2=3.5):GOSUB 1000
60 C=(2^10=1024):GOSUB 1000
70 C=(INT(-3.7)=-4):GOSUB 1000
80 C=(ABS(-5)=5 AND SGN(-5)=-1 AND SGN(0)=0):GOSUB 1000
90 C=(100000*100000=1E10):GOSUB 1000
100 C=(1/3*3=1):GOSUB 1000
110 REM ---- THE MATH UNIT: SQR SIN COS EXP LOG ATN
120 C=(ABS(SQR(2)-1.414214)<1E-5):GOSUB 1000
130 C=(ABS(SIN(1)-.841471)<1E-5):GOSUB 1000
140 C=(ABS(COS(1)-.540302)<1E-5):GOSUB 1000
150 C=(ABS(EXP(1)-2.718282)<1E-5):GOSUB 1000
160 C=(ABS(LOG(10)-2.302585)<1E-5):GOSUB 1000
170 C=(ABS(ATN(1)*4-3.141593)<1E-5):GOSUB 1000
180 C=(ABS(TAN(1)-1.557408)<1E-5):GOSUB 1000
190 REM ---- STRINGS
200 A$="HELLO":B$=" WORLD"
210 C=(A$+B$="HELLO WORLD"):GOSUB 1000
220 C=(LEFT$(A$,2)="HE" AND MID$(A$,2,3)="ELL" AND RIGHT$(A$,3)="LLO"):GOSUB 1000
230 C=(LEN(A$+B$)=11 AND ASC("A")=65 AND CHR$(66)="B"):GOSUB 1000
240 C=(STR$(42)=" 42" AND VAL("3.5")=3.5 AND VAL("-12")=-12):GOSUB 1000
250 C=(A$<"HELP" AND A$>"HELL"):GOSUB 1000
260 REM ---- CONTROL FLOW, FUNCTIONS, ARRAYS
270 S=0:FOR I=1 TO 100:S=S+I:NEXT:C=(S=5050):GOSUB 1000
280 S=0:FOR I=10 TO 1 STEP -3:S=S+I:NEXT:C=(S=22):GOSUB 1000
290 DEF FNQ(X)=X*X+1:C=(FNQ(7)=50):GOSUB 1000
300 DIM A(10),B(3,3):FOR I=0 TO 10:A(I)=I*I:NEXT:B(2,3)=77
310 C=(A(10)=100 AND A(3)=9 AND B(2,3)=77 AND B(3,2)=0):GOSUB 1000
320 K=2:ON K GOTO 330,340
330 C=0:GOSUB 1000:GOTO 350
340 C=-1:GOSUB 1000
350 C=((1=1)=-1 AND (1=2)=0 AND (3 AND 5)=1 AND (3 OR 5)=7 AND NOT 0=-1):GOSUB 1000
360 REM ---- THE MACHINE: SYS REGISTERS, THE FRAME COUNTER, POKE/PEEK
370 C=(PEEK(54528)+256*PEEK(54529)=40500):GOSUB 1000
380 C=(PEEK(54530)+256*PEEK(54531)=256):GOSUB 1000
390 T=PEEK(54541):FOR I=1 TO 20000:IF PEEK(54541)<>T THEN I=20000
395 NEXT:C=(PEEK(54541)<>T):GOSUB 1000
400 POKE 1039,123:C=(PEEK(1039)=123):GOSUB 1000
410 REM ---- GRAPHICS: THE BITMAP OVER THE TEXT, THEN THE TEXT MODE BACK
420 GRAPHICS 2:PLOT 10,10,17:LINE 0,0,639,479,18:TRI 100,100,200,100,150,200,19:PALETTE 17,255,0,0:GCLS:GRAPHICS 0
430 C=-1:GOSUB 1000
440 REM ---- FILES: SAVE WRITES THROUGH THE ROM; THE HARNESS CHECKS THE FILE
450 SAVE "TESTOUT.BAS":C=-1:GOSUB 1000
460 REM ---- THE * ESCAPE
470 *ECHO STAR OK
480 C=-1:GOSUB 1000
490 PRINT "EHTEST: ";N-F;" OF ";N;" CHECKS"
500 IF F=0 THEN PRINT "EHTEST PASSED"
510 IF F>0 THEN PRINT "EHTEST FAILED"
520 END
1000 N=N+1:IF NOT C THEN F=F+1:PRINT "FAIL AT CHECK";N
1010 RETURN
