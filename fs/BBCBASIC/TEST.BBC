   10 REM BMC-K4510 BBC BASIC SELF-TEST. LOAD "BBCBASIC/TEST.BBC" THEN RUN: SILENT UNLESS A CHECK FAILS.
   20 N%=0:F%=0
   30 REM ---- ARITHMETIC AND THE FLOATS
   40 PROCc(6*7=42):PROCc(7/2=3.5):PROCc(2^10=1024):PROCc(INT(-3.7)=-4)
   50 PROCc(7 DIV 2=3 AND 7 MOD 2=1 AND -7 DIV 2=-3):PROCc(ABS(SQR(2)-1.414213562)<1E-8)
   60 PROCc(ABS(SIN(1)-0.841470985)<1E-8):PROCc(ABS(EXP(1)-2.718281828)<1E-8):PROCc(ABS(LN(10)-2.302585093)<1E-8):PROCc(ABS(ATN(1)*4-PI)<1E-8)
   70 A%=&7FFFFFFF:PROCc(A%+1=2147483648):PROCc(&FF=255 AND %1010=10)
   80 REM ---- STRINGS
   90 A$="HELLO":PROCc(A$+" WORLD"="HELLO WORLD"):PROCc(LEFT$(A$,2)="HE" AND MID$(A$,2,3)="ELL" AND RIGHT$(A$,3)="LLO")
  100 PROCc(LEN(A$)=5 AND ASC("A")=65 AND CHR$(66)="B" AND STR$(42)="42" AND VAL("3.5")=3.5 AND INSTR(A$,"LL")=3)
  110 PROCc(STRING$(3,"AB")="ABABAB" AND EVAL("2+3")=5)
  120 REM ---- CONTROL FLOW, PROCEDURES, ARRAYS, INTEGERS
  130 S%=0:FOR I%=1 TO 100:S%+=I%:NEXT:PROCc(S%=5050)
  140 S%=0:REPEAT S%+=1:UNTIL S%=10:PROCc(S%=10):S%=0:WHILE S%<5:S%+=1:ENDWHILE:PROCc(S%=5)
  150 PROCc(FNsq(7)=49):DIM V(10),M(3,3):FOR I%=0 TO 10:V(I%)=I%*I%:NEXT:M(2,3)=77:PROCc(V(10)=100 AND M(2,3)=77 AND M(3,2)=0)
  160 X%=2:CASE X% OF
  162 WHEN 1:PROCc(FALSE)
  164 WHEN 2:PROCc(TRUE)
  166 OTHERWISE PROCc(FALSE)
  168 ENDCASE
  170 PROCc(TRUE=-1 AND FALSE=0 AND (3 AND 5)=1 AND (3 OR 5)=7 AND (3 EOR 5)=6)
  180 REM ---- THE MACHINE: TIME, THE KEYBOARD, THE FILE SYSTEM THROUGH THE TUBE
  190 T%=TIME:REPEAT UNTIL TIME>T%+5:PROCc(TIME>T%):PROCc(INKEY(0)=-1)
  200 X%=OPENOUT("TESTOUT.TXT"):PRINT#X%,"HELLO TUBE",1234:CLOSE#X%
  210 Y%=OPENIN("TESTOUT.TXT"):INPUT#Y%,B$,B%:CLOSE#Y%:PROCc(B$="HELLO TUBE" AND B%=1234)
  220 REM ---- GRAPHICS AND SOUND THROUGH THE ULA (NO READBACK: THE ESCAPES MUST NOT DERAIL THE STREAM)
  230 MODE 2:GCOL 0,1:PLOT 85,100,100:DRAW 500,500:CIRCLE FILL 640,512,100:VDU 19,1,3,0,0,0
  240 VDU 23,27,0,1|:VDU 23,27,1,32,32|:PLOT &ED,300,300:VDU 23,27,2,1|
  250 SOUND 1,-10,100,2:SOUND 1,0,0,0
  260 MODE 7:PROCc(TRUE)
  270 REM ---- STAR COMMANDS GO TO THE SHELL
  280 *ECHO STAR OK
  290 PROCc(TRUE)
  300 PRINT "BBCTEST: ";N%-F%;" OF ";N%;" CHECKS"
  310 IF F%=0 PRINT "BBCTEST PASSED" ELSE PRINT "BBCTEST FAILED"
  320 END
  330 DEF PROCc(c):N%+=1:IF NOT c THEN F%+=1:PRINT "FAIL AT CHECK ";N%
  340 ENDPROC
  350 DEF FNsq(x)=x*x
