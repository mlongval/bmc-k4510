1 REM RUGG/FELDMAN BENCHMARK 7 (1977), TIMED BY THE $D50D FRAME COUNTER
2 T=PEEK(54541)+256*PEEK(54542)
300 PRINT"S"
400 K=0
430 DIM M(5)
500 K=K+1
510 LET A=K/2*3+4-5
520 GOSUB 820
530 FOR L=1 TO 5
535 M(L)=A
540 NEXT L
600 IF K<1000 THEN 500
700 PRINT"E"
750 T=PEEK(54541)+256*PEEK(54542)-T
760 IF T<0 THEN T=T+65536
770 PRINT "TIME:";T;"FRAMES =";INT(T/0.6)/100;"SECONDS"
800 END
820 RETURN
