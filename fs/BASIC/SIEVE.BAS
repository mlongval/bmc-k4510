0 REM ERATOSTHENES SIEVE (BYTE, SEPT 1981). NEEDS 48 KB FOR THE FLOAT ARRAY: OUT OF MEMORY ON EHBASIC AT $6C00 (25 KB FREE)
1 SIZE=8190
2 DIM FLAGS(8191)
3 PRINT "ONLY 1 ITERATION"
4 T=PEEK(54541)+256*PEEK(54542)
5 COUNT=0
6 FOR I=0 TO SIZE
7 FLAGS(I)=1
8 NEXT I
9 FOR I=0 TO SIZE
10 IF FLAGS(I)=0 THEN 18
11 PRIME=I+I+3
12 K=I+PRIME
13 IF K>SIZE THEN 17
14 FLAGS(K)=0
15 K=K+PRIME
16 GOTO 13
17 COUNT=COUNT+1
18 NEXT I
19 PRINT COUNT;" PRIMES"
750 T=PEEK(54541)+256*PEEK(54542)-T
760 IF T<0 THEN T=T+65536
770 PRINT "TIME:";T;"FRAMES =";INT(T/0.6)/100;"SECONDS"
900 PRINT: PRINT "ANY KEY...";: GET K$: IF K$="" THEN 900
910 IF PEEK(1039) THEN LOAD "BENCH.BAS"
