10 REM EXPRESSION BENCHMARK: 20000 EVALUATIONS, NO FUNCTIONS
20 T=PEEK(54541)+256*PEEK(54542)
30 A=0:B=1.5:C=2.5:D=3:E=7
40 FOR I=1 TO 20000
50 A=A+B*C-D/E+I*0.001
60 NEXT
70 T=PEEK(54541)+256*PEEK(54542)-T
80 IF T<0 THEN T=T+65536
90 PRINT "A =";A
100 PRINT "TIME:";T;"FRAMES =";INT(T/0.6)/100;"SECONDS"
110 PRINT "COMPILED";PEEK(1051);"BAILED";PEEK(1052);"HITS";PEEK(1053)
900 PRINT: PRINT "ANY KEY...";
905 GET K$: IF K$="" THEN 905
910 IF PEEK(1039) THEN LOAD "BENCH.BAS"
