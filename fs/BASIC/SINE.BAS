10 REM SINE WAVES PLOTTED POINT BY POINT
20 GRAPHICS 2
30 PALETTE 1,255,255,255:PALETTE 2,255,120,0:PALETTE 3,0,200,255
40 LINE 0,240,639,240,1
50 FOR X=0 TO 639
60 PLOT X,240-100*SIN(X/40),2
70 PLOT X,240-60*SIN(X/15),3
80 NEXT
90 PRINT "ANY KEY"
95 GET K$:IF K$="" THEN 95
100 GRAPHICS 0
990 IF PEEK(1039) THEN LOAD "DEMOS.BAS"
