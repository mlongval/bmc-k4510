10 REM STARFIELD: 64 STARS FLYING AT YOU
15 X=RND(PEEK(54541)+1):REM SEED FROM THE FRAME COUNTER
20 GRAPHICS 1
30 PALETTE 16,255,255,255:PALETTE 17,160,160,160:PALETTE 18,90,90,90
40 DIM X(64),Y(64),Z(64)
50 FOR I=1 TO 64:X(I)=RND(0)*320-160:Y(I)=RND(0)*240-120:Z(I)=RND(0)*100+1:NEXT
60 FOR F=1 TO 600
70 GCLS
80 FOR I=1 TO 64
90 Z(I)=Z(I)-2:IF Z(I)<1 THEN Z(I)=100:X(I)=RND(0)*320-160:Y(I)=RND(0)*240-120
100 SX=160+X(I)*40/Z(I):SY=120+Y(I)*40/Z(I)
110 C=18:IF Z(I)<60 THEN C=17
120 IF Z(I)<30 THEN C=16
130 PLOT SX,SY,C
140 NEXT:NEXT
145 PRINT "ANY KEY"
146 GET K$:IF K$="" THEN 146
150 GRAPHICS 0
990 IF PEEK(1039) THEN LOAD "DEMOS.BAS"
