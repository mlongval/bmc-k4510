1 REM AHL'S SIMPLE BENCHMARK (CREATIVE COMPUTING, 1983), RND(0) = NEXT RANDOM IN EHBASIC
2 T=PEEK(54541)+256*PEEK(54542)
3 X=RND(1): REM EHBASIC STARTS WITH A ZERO SEED; RND(0) WOULD RETURN 0 FOREVER
3 REM AHL'S BENCHMARK (CREATIVE COMPUTING 1983): 100 ROUNDS OF TEN SQR AND
4 REM TEN SQUARINGS PLUS RANDOM SUMS. ACCURACY: SMALLER IS BETTER (HOW MUCH
5 REM 10 X SQR THEN 10 X ^2 DRIFTS FROM THE TRUE VALUE). RANDOM: UNDER 15 GOOD.
10 REM AHL'S SIMPLE BENCHMARK
20 FOR N=1 TO 100: A=N
30 FOR I=1 TO 10
40 A=SQR(A): R=R+RND(0)
50 NEXT I
60 FOR I=1 TO 10
70 A=A^2: R=R+RND(0)
80 NEXT I
90 S=S+A: NEXT N
100 PRINT "ACCURACY";ABS(1010-S/5)
110 PRINT "RANDOM";ABS(1000-R)
750 T=PEEK(54541)+256*PEEK(54542)-T
760 IF T<0 THEN T=T+65536
770 PRINT "TIME:";T;"FRAMES =";INT(T/0.6)/100;"SECONDS"
780 PRINT "FOR SCALE (FROM THE 1984 ARTICLE):  C64 1:53   APPLE IIE 1:53"
781 PRINT "  TRS-80 III 1:59   IBM PC 0:24   IBM PC COMPILED 0:06"
900 PRINT: PRINT "ANY KEY...";
