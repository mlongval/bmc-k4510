10 REM SID DEMO 2: DRUMS ON SID1, BASS ON SID0 - TWO CHIPS, A LOOP.  S0=54272 S1=54304
20 S0=54272: S1=54304: POKE S0+24,15: POKE S1+24,15
30 DIM B(8): FOR I=1 TO 8: READ B(I): NEXT: REM BASS NOTES (SID FREQ WORDS)
40 DATA 1845,1845,2195,1845,1464,1464,1845,1640
50 PRINT CHR$(12);"SID DEMO 2: BEAT  (SID0 BASS, SID1 DRUMS)": PRINT "ANY KEY STOPS"
60 POKE S0+5,1*16+10: POKE S0+6,8*16+4: POKE S0+2,0: POKE S0+3,4: REM BASS: PULSE 25%
70 POKE S1+5,0*16+6: POKE S1+6,0*16+4: REM DRUM: SHORT DECAY
80 FOR R=1 TO 1000
90 FOR N=1 TO 8
100 POKE S0+0,B(N) AND 255: POKE S0+1,INT(B(N)/256): POKE S0+4,65
110 IF (N AND 1) THEN POKE S1+1,8: POKE S1+4,129: REM KICK: NOISE BURST LOW
120 IF (N AND 3)=3 THEN POKE S1+1,40: POKE S1+4,129: REM SNARE: NOISE HIGHER
130 GOSUB 9000
140 POKE S0+4,64: POKE S1+4,128: GOSUB 9000
150 IF PEEK(53505)>127 THEN 200: REM A KEY WAITING? (KBDST $D101)
160 NEXT: NEXT
200 GET K$: POKE S0+4,0: POKE S1+4,0: POKE S0+24,0: POKE S1+24,0
990 IF PEEK(1039) THEN LOAD "DEMOS.BAS"
995 END
9000 REM WAIT 4 FRAMES
9010 FOR J=1 TO 4: T=PEEK(54541)
9020 IF PEEK(54541)=T THEN 9020
9030 NEXT: RETURN
