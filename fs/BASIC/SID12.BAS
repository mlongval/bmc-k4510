10 REM SID12: 4 SIDS, 12 VOICES. PACHELBEL IN D, 8 BARS AT 120 BPM. SAME MUSIC AS SID12.PRG, IN BASIC.
20 DIM F(12): FOR I=0 TO 12: F(I)=INT(2195*2^(I/12)+0.5): NEXT: REM OCTAVE 3 FREQUENCY WORDS (1 MHZ SID)
30 DIM R(8),M(8): FOR I=1 TO 8: READ R(I),M(I): NEXT: REM CHORD ROOTS (NOTE NUMBERS, 12*OCTAVE+SEMITONE) AND MINOR FLAGS
40 DATA 38,0,45,0,47,1,42,1,43,0,38,0,43,0,45,0
50 DIM L(64): FOR I=1 TO 64: READ L(I): NEXT: REM THE MELODY, ONE NOTE PER EIGHTH, 0 = HOLD
60 DATA 66,0,64,0,62,0,61,0,59,0,57,0,59,0,61,0,62,0,61,0,59,0,57,0,55,0,66,0,55,0,57,0
70 DATA 62,66,69,67,66,62,66,64,62,59,62,69,55,59,57,55,54,50,52,61,62,66,69,69,59,67,69,66,69,61,62,0
80 NC=4: FOR C=0 TO NC-1: S=54272+32*C: FOR I=0 TO 24: POKE S+I,0: NEXT: POKE S+24,15: NEXT
90 S0=54272: S1=54304: S2=54336: S3=54368: DIM U(12): K$="1234567890AB"
100 POKE S0+5,0: POKE S0+6,168: POKE S0+23,1: POKE S0+22,80: POKE S0+24,31: REM BASS THROUGH THE LOW-PASS
110 POKE S0+12,25: POKE S0+13,120: POKE S0+10,6: POKE S0+19,25: POKE S0+20,120: POKE S0+17,10: REM CHORD: SOFT PULSES
120 POKE S1+5,9: POKE S1+6,105: POKE S1+12,0: POKE S1+13,40: POKE S1+10,3: POKE S1+19,0: POKE S1+20,6: REM MELODY, ARP, DRUMS
130 FOR V=0 TO 14 STEP 7: POKE S2+5+V,138: POKE S2+6+V,138: NEXT: POKE S2+24,9: REM PAD: SLOW, QUIETER
140 POKE S3+5,9: POKE S3+6,55: POKE S3+3,8: POKE S3+12,0: POKE S3+13,71: POKE S3+19,0: POKE S3+20,3: POKE S3+24,10: REM ECHO, BASS 8VA, HI-HAT
150 PRINT CHR$(12);"SID12: 4 SIDS, 12 VOICES -- PACHELBEL IN D": PRINT "KEYS 1-9, 0, A, B TOGGLE A VOICE; Q STOPS": PRINT
155 GOSUB 9300
160 FOR T=1 TO 9999
170 FOR B=1 TO 8: RT=R(B): TH=RT+4+M(B)*(-1): FI=RT+7
180 GOSUB 9100: REM BAR: BASS, CHORD, PAD
190 FOR E=1 TO 8: ST=(B-1)*8+E
200 IF E=3 OR E=7 THEN N=RT-12+7: V=0: S=S0: W=32: GOSUB 9000: REM BASS: THE FIFTH ON 2 AND 4
210 N=L(ST): IF N THEN V=0: S=S1: W=16: GOSUB 9000: REM MELODY
220 N=RT+12+(E AND 3)*0: IF (E AND 3)=1 THEN N=RT+12
222 IF (E AND 3)=2 THEN N=TH+12
224 IF (E AND 3)=3 THEN N=FI+12
226 IF (E AND 3)=0 THEN N=RT+24
228 V=1: S=S1: W=64: GOSUB 9000: REM ARPEGGIO, ONE NOTE PER EIGHTH
230 IF (E AND 1) THEN N=24+(E AND 2)*24: V=2: S=S1: W=128: GOSUB 9000: REM KICK ON 1,3  SNARE ON 2,4
240 N=L(((ST+61) AND 63)+1): IF N THEN V=0: S=S3: W=64: GOSUB 9000: REM ECHO, TWO EIGHTHS LATE
250 IF (E AND 1)=0 THEN N=RT: V=1: S=S3: W=32: GOSUB 9000: REM BASS AN OCTAVE UP, OFF-BEATS
260 N=84: V=2: S=S3: W=128: GOSUB 9000: REM HI-HAT EVERY EIGHTH
300 GOSUB 9200: POKE S1+18,128: GOSUB 9200: REM TWO HALF-EIGHTHS; DRUM GATE OFF BETWEEN
310 IF PEEK(53505)>127 THEN GOSUB 9400: IF QQ THEN 400
320 NEXT: NEXT: NEXT
400 GET K$: FOR C=0 TO NC-1: S=54272+32*C: FOR I=0 TO 24: POKE S+I,0: NEXT: NEXT
990 IF PEEK(1039) THEN LOAD "DEMOS.BAS"
995 END
9000 REM PLAY NOTE N ON VOICE V OF CHIP S WITH WAVEFORM W: FREQ WORD FROM OCTAVE 3, SHIFTED
9010 O=INT(N/12): Q=F(N-O*12): IF O>3 THEN Q=Q*2^(O-3)
9020 IF O<3 THEN Q=INT(Q/2^(3-O))
9025 IF U((S-54272)/32*3+V+1) THEN RETURN: REM MUTED
9030 H=INT(Q/256): POKE S+V*7,Q-H*256: POKE S+V*7+1,H: POKE S+V*7+4,W: POKE S+V*7+4,W+1: RETURN
9100 N=RT-12: V=0: S=S0: W=32: GOSUB 9000: N=TH: V=1: W=64: GOSUB 9000: N=FI: V=2: GOSUB 9000
9110 S=S2: N=RT+12: V=0: W=16: GOSUB 9000: N=TH+12: V=1: GOSUB 9000: N=FI+12: V=2: GOSUB 9000
9120 RETURN
9300 REM SHOW THE VOICES
9310 PRINT CHR$(12);"SID12: 4 SIDS, 12 VOICES -- PACHELBEL IN D": PRINT "KEYS 1-9, 0, A, B TOGGLE A VOICE; Q STOPS": PRINT
9320 FOR I=1 TO 12: PRINT " ";MID$(K$,I,1);"  SID ";INT((I-1)/3);".";((I-1)-INT((I-1)/3)*3)+1;"  ";: IF U(I) THEN PRINT "OFF"
9330 PRINT "ON"
9340 NEXT: RETURN
9400 REM A KEY: TOGGLE A VOICE OR QUIT
9410 GET A$: QQ=0: IF A$="Q" OR A$="q" OR A$=CHR$(27) THEN QQ=1: RETURN
9420 FOR I=1 TO 12: IF MID$(K$,I,1)=A$ THEN U(I)=1-U(I): C=INT((I-1)/3): S=54272+32*C: V=(I-1)-C*3: POKE S+V*7+4,0
9430 NEXT: GOSUB 9300: RETURN
9200 REM WAIT 7 FRAMES (HALF AN EIGHTH AT 120 BPM, MINUS THE INTERPRETER)
9210 FOR J=1 TO 7: TT=PEEK(54541)
9220 IF PEEK(54541)=TT THEN 9220
9230 NEXT: RETURN
