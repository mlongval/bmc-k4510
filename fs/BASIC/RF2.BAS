1 REM RUGG/FELDMAN BENCHMARK 2 (1977), TIMED BY THE $D50D FRAME COUNTER
2 T=PEEK(54541)+256*PEEK(54542)
3 REM RUGG/FELDMAN 2: THE SAME LOOP BUILT FROM IF/GOTO: LINE LOOKUP EVERY TIME ROUND
300 PRINT"S"
400 K=0
500 K=K+1
600 IF K<1000 THEN 500
700 PRINT"E"
750 T=PEEK(54541)+256*PEEK(54542)-T
760 IF T<0 THEN T=T+65536
770 PRINT "TIME:";T;"FRAMES =";INT(T/0.6)/100;"SECONDS"
780 PRINT "FOR SCALE (STOPWATCH-ERA, APPROXIMATE):"
781 PRINT "  C64 / APPLE IIE (1 MHZ, MS BASIC): 9.3 S"
782 PRINT "  BBC MICRO B (2 MHZ, BBC BASIC):    3.1 S"
783 PRINT "  MEGA65 (40.5 MHZ, BASIC65):        ROUGHLY 0.23 S"
800 GOTO 900
900 PRINT: PRINT "ANY KEY...";
905 GET K$: IF K$="" THEN 905
910 IF PEEK(1039) THEN LOAD "BENCH.BAS"
