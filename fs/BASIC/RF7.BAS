1 REM RUGG/FELDMAN BENCHMARK 7 (1977), TIMED BY THE $D50D FRAME COUNTER
2 T=PEEK(54541)+256*PEEK(54542)
3 REM RUGG/FELDMAN 7: ADDS AN ARRAY STORE M(L)=A IN THE INNER LOOP
300 PRINT"S"
400 K=0
430 DIM M(5)
500 K=K+1
510 LET A=K/2*3+4-5
520 GOSUB 820
530 FOR L=1 TO 5
535 M(L)=A
540 NEXT L
600 IF K<1000 THEN 500
700 PRINT"E"
750 T=PEEK(54541)+256*PEEK(54542)-T
760 IF T<0 THEN T=T+65536
770 PRINT "TIME:";T;"FRAMES =";INT(T/0.6)/100;"SECONDS"
780 PRINT "FOR SCALE (STOPWATCH-ERA, APPROXIMATE):"
781 PRINT "  C64 / APPLE IIE (1 MHZ, MS BASIC): 47.5 S"
782 PRINT "  BBC MICRO B (2 MHZ, BBC BASIC):    21.2 S"
783 PRINT "  MEGA65 (40.5 MHZ, BASIC65):        ROUGHLY 1.19 S"
800 GOTO 900
820 RETURN
900 PRINT: PRINT "ANY KEY...";
905 GET K$: IF K$="" THEN 905
910 IF PEEK(1039) THEN LOAD "BENCH.BAS"
