1 REM SPACE INVADERS WITH HARDWARE SPRITES (SPRITE/SPRDEF/SPROFF ARE K4510
2 REM EHBASIC STATEMENTS; SEE INVADERS.BAS FOR THE TEXT-SCREEN VERSION).
3 REM SHAPES ARE POKED INTO FAR MEMORY AT $040000 THROUGH BANK REGISTER 1,
4 REM 4BPP, AND USE PALETTE COLOURS 16+. A/D OR CURSORS MOVE, SPACE FIRES, Q QUITS.
10 POKE 54788,0: POKE 54789,0: POKE 54790,4: POKE 54791,0: REM BANK 1 -> $040000
20 PALETTE 17,80,255,120: PALETTE 18,255,255,255: PALETTE 19,255,220,80: PALETTE 20,255,80,80
30 REM ---- SHAPES: 16 ROWS OF 15-BIT MASKS, TWO PIXELS PER BYTE ----
40 RESTORE: FOR S=0 TO 3: READ C: FOR R=0 TO 15: READ M: B=8192+S*256+R*8
50 FOR X=0 TO 7: P=0: IF M AND INT(2^(14-X*2)) THEN P=C*16
60 IF M AND INT(2^(13-X*2)) THEN P=P+C
70 POKE B+X,P: NEXT: NEXT: NEXT
80 REM INVADER (COLOUR 1 -> 17)
90 DATA 1, 4680,9288,9288,32754,32754,15084,15084,4680, 0,0,0,0,0,0,0,0
100 REM PLAYER (2 -> 18)
110 DATA 2, 384,960,960,16380,32766,32766,32766,32766, 0,0,0,0,0,0,0,0
120 REM BULLET (3 -> 19)
130 DATA 3, 384,384,384,384,384,384,384,384, 0,0,0,0,0,0,0,0
140 REM BOMB (4 -> 20)
150 DATA 4, 384,960,384,960,384,960,384,960, 0,0,0,0,0,0,0,0
160 REM ---- SPRITES: 0 PLAYER, 1-24 INVADERS, 25 BULLET, 26 BOMB ----
170 SPRDEF 0,1025,16,16,4: FOR I=1 TO 24: SPRDEF I,1024,16,16,4: NEXT
180 SPRDEF 25,1026,16,16,4: SPRDEF 26,1027,16,16,4
190 SC=0: LI=3: WV=1: DIM A(24)
200 PRINT CHR$(12): PRINT "  INVADERS WITH SPRITES   A/D OR CURSORS, SPACE FIRES, Q QUITS"
210 REM ---- NEW WAVE ----
220 NA=24: FOR I=1 TO 24: A(I)=1: NEXT
230 GX=80: GY=40: DI=4: MM=20-WV*3: IF MM<4 THEN MM=4
240 MC=MM: PX=312: BY=0: EY=0
250 GOSUB 8000: SPRITE 0,PX,220
260 REM ---- MAIN LOOP ----
270 TF=PEEK(54541)
280 IF PEEK(54541)=TF THEN 280
290 GET K$
300 IF K$="Q" OR K$="q" THEN 700
310 IF (K$="A" OR K$="a" OR K$=CHR$(130)) AND PX>8 THEN PX=PX-6: SPRITE 0,PX,220
320 IF (K$="D" OR K$="d" OR K$=CHR$(131)) AND PX<616 THEN PX=PX+6: SPRITE 0,PX,220
330 IF K$=" " AND BY=0 THEN BY=212: BX=PX: SPRITE 25,BX,BY
340 IF BY THEN GOSUB 8200
350 IF EY THEN GOSUB 8400
360 IF EY=0 AND RND(0)<0.03 THEN GOSUB 8300
370 MC=MC-1: IF MC=0 THEN MC=MM: GOSUB 8100
380 IF NA=0 THEN WV=WV+1: PRINT "WAVE CLEARED": FOR I=1 TO 60: GOSUB 9100: NEXT: GOTO 220
390 GOTO 270
700 REM ---- GAME OVER ----
710 PRINT "GAME OVER  SCORE";SC
720 FOR I=0 TO 26: SPROFF I: NEXT
730 POKE 54791,255
740 IF PEEK(1039) THEN LOAD "DEMOS.BAS"
750 END
8000 REM DRAW THE LIVE GRID
8010 FOR R=0 TO 2: FOR C=0 TO 7: I=R*8+C+1
8020 IF A(I) THEN SPRITE I,GX+C*40,GY+R*24
8030 NEXT: NEXT: RETURN
8100 REM MARCH
8110 GX=GX+DI
8120 IF GX<8 OR GX>320 THEN DI=-DI: GX=GX+DI: GY=GY+10: MM=MM-1: IF MM<3 THEN MM=3
8130 IF GY>180 THEN LI=0: GOTO 700
8140 GOSUB 8000: RETURN
8200 REM BULLET
8210 BY=BY-10: IF BY<20 THEN BY=0: SPROFF 25: RETURN
8220 SPRITE 25,BX,BY
8230 C=INT((BX-GX+8)/40): R=INT((BY-GY+8)/24)
8240 IF C<0 OR C>7 OR R<0 OR R>2 THEN RETURN
8250 I=R*8+C+1: IF A(I)=0 THEN RETURN
8260 IF ABS(BX-(GX+C*40))<12 AND ABS(BY-(GY+R*24))<12 THEN A(I)=0: NA=NA-1: SC=SC+10: SPROFF I: SPROFF 25: BY=0: PRINT "SCORE";SC
8270 RETURN
8300 REM A BOMB DROPS
8310 I=INT(RND(0)*24)+1: IF A(I)=0 THEN RETURN
8320 R=INT((I-1)/8): C=(I-1)-R*8: EX=GX+C*40: EY=GY+R*24+16
8330 SPRITE 26,EX,EY: RETURN
8400 REM BOMB FALLS
8410 EY=EY+6: IF EY>236 THEN EY=0: SPROFF 26: RETURN
8420 SPRITE 26,EX,EY
8430 IF EY>208 AND ABS(EX-PX)<12 THEN GOSUB 8500
8440 RETURN
8500 REM PLAYER HIT
8510 LI=LI-1: EY=0: SPROFF 26: PRINT "OUCH! LIVES";LI
8520 IF LI=0 THEN 700
8530 RETURN
9100 TF=PEEK(54541)
9110 IF PEEK(54541)=TF THEN 9110
9120 RETURN
