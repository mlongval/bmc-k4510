10 REM SID DEMO 1: ONE VOICE, THE FOUR WAVEFORMS, A SCALE EACH.  SID0 = 54272 ($D400)
20 S=54272: POKE S+24,15: REM VOLUME 15, NO FILTER
25 FOR I=0 TO 24: POKE S+I,0: NEXT: POKE S+24,15: REM EVERY REGISTER CLEARED FIRST (A VOICE LEFT ROUTED INTO AN UNSET FILTER IS SILENT)
30 DIM F(12): FOR I=0 TO 12: F(I)=INT(7382*2^(I/12)+0.5): NEXT: REM C4 = 7382 = 440 HZ * 2^(-9/12) / 0.0596
40 DIM W(3),W$(3): W(0)=17:W$(0)="TRIANGLE": W(1)=33:W$(1)="SAWTOOTH": W(2)=65:W$(2)="PULSE": W(3)=129:W$(3)="NOISE"
50 PRINT CHR$(12);"SID DEMO 1: WAVEFORMS": PRINT
60 POKE S+2,0: POKE S+3,8: REM PULSE WIDTH 50%
70 FOR V=0 TO 3
80 PRINT W$(V);: POKE S+5,0*16+9: POKE S+6,15*16+0: REM ATTACK 0 DECAY 9, SUSTAIN 15 RELEASE 0
90 FOR N=0 TO 12 STEP 2
100 POKE S+0,F(N) AND 255: POKE S+1,INT(F(N)/256)
110 POKE S+4,W(V): GOSUB 9000: GOSUB 9000: POKE S+4,W(V)-1: GOSUB 9000
120 PRINT ".";
130 NEXT: PRINT
140 NEXT
150 POKE S+4,0: POKE S+24,0
160 PRINT: PRINT "ANY KEY"
170 GET K$: IF K$="" THEN 170
990 IF PEEK(1039) THEN LOAD "DEMOS.BAS"
995 END
9000 REM WAIT 4 FRAMES (1/15 S)
9010 FOR J=1 TO 4: T=PEEK(54541): 
9020 IF PEEK(54541)=T THEN 9020
9030 NEXT: RETURN
