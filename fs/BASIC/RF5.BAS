1 REM RUGG/FELDMAN BENCHMARK 5 (1977), TIMED BY THE $D50D FRAME COUNTER
2 T=PEEK(54541)+256*PEEK(54542)
3 REM RUGG/FELDMAN 5: ADDS A GOSUB/RETURN EACH TIME ROUND
300 PRINT"S"
400 K=0
500 K=K+1
510 LET A=K/2*3+4-5
520 GOSUB 820
600 IF K<1000 THEN 500
700 PRINT"E"
750 T=PEEK(54541)+256*PEEK(54542)-T
760 IF T<0 THEN T=T+65536
770 PRINT "TIME:";T;"FRAMES =";INT(T/0.6)/100;"SECONDS"
780 PRINT "FOR SCALE (STOPWATCH-ERA, APPROXIMATE):"
781 PRINT "  C64 / APPLE IIE (1 MHZ, MS BASIC): 21.0 S"
782 PRINT "  BBC MICRO B (2 MHZ, BBC BASIC):    9.0 S"
783 PRINT "  MEGA65 (40.5 MHZ, BASIC65):        ROUGHLY 0.53 S"
800 GOTO 900
820 RETURN
900 PRINT: PRINT "ANY KEY...";
905 GET K$: IF K$="" THEN 905
910 IF PEEK(1039) THEN LOAD "BENCH.BAS"
