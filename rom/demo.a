; BMC-K4510 demo ROM: SHEILA gradient, text layer, a bouncing sprite.
; Everything below is done by the 45GS02 through VICKe's registers.
!cpu m65
VICKE  = $D000
FONT   = $010000
SCREEN = $0800
SPRTAB = $2000          ; sprite table (128 x 16)
SPRDAT = $3000          ; 16x16 8bpp ball
SHLIST = $4000          ; SHEILA list
BX     = $40            ; ball x (16-bit), y, dx, dy
BY     = $42
DX     = $44
DY     = $45

*= $F000
RESET:  cld
        sei
        ldx #$FF
        txs
        lda #0
        sta VICKE+$00
        ; palette: 0 = black, 1 = white, 16..47 = sky gradient (dark blue -> light)
        lda #16
        sta VICKE+$06
        ldx #0
.pal:   lda #$10
        sta VICKE+$07           ; R
        txa
        asl
        clc
        adc #$20
        sta VICKE+$08           ; G = 32 + 2i
        txa
        asl
        asl
        clc
        adc #$60
        sta VICKE+$09           ; B = 96 + 4i  (commits, index++)
        inx
        cpx #32
        bne .pal
        ; entry 48 = ball colour (orange), 49 = ball shade
        lda #48
        sta VICKE+$06
        lda #$FF
        sta VICKE+$07
        lda #$80
        sta VICKE+$08
        lda #$20
        sta VICKE+$09
        lda #$C0
        sta VICKE+$07
        lda #$50
        sta VICKE+$08
        lda #$10
        sta VICKE+$09
        ; text layer 0: map SCREEN, glyphs FONT, 80/row, palofs 0 -> fg index 1 (white)
        lda #80
        sta VICKE+$16
        lda #0
        sta VICKE+$17
        lda #<SCREEN
        sta VICKE+$1C
        lda #>SCREEN
        sta VICKE+$1D
        lda #0
        sta VICKE+$1E
        sta VICKE+$1F
        lda #<FONT
        sta VICKE+$18
        lda #>FONT
        sta VICKE+$19
        lda #^FONT
        sta VICKE+$1A
        lda #0
        sta VICKE+$1B
        sta VICKE+$11
        lda #%00000101
        sta VICKE+$10
        jsr CLS
        jsr TEXT
        jsr BALL
        jsr SHEILA
        lda #16
        sta VICKE+$01           ; initial background
        lda #1
        sta VICKE+$00           ; display on
        jsr SOUND
        ; ---- main loop: wait vblank, move the ball ----
LOOP:   lda VICKE+$04
        and #1
        beq LOOP
        lda #1
        sta VICKE+$04           ; ack vblank
        ; x += dx
        lda BX
        clc
        adc DX
        sta BX
        lda BX+1
        adc #0                  ; dx is +1 or -1 (as $FF): handle sign
        ldy DX
        bpl .xp
        sec
        sbc #1                  ; borrow for negative dx
.xp:    sta BX+1
        ; bounce x: 0 <= x <= 624
        lda BX+1
        bmi .xneg
        cmp #2
        bcc .xok
        lda BX
        cmp #113                ; 624 = $0270 -> hi 2, lo 112
        bcc .xok
.xflip: lda DX
        eor #$FF
        clc
        adc #1
        sta DX
        jmp .xok
.xneg:  jmp .xflip
.xok:   ; y += dy (8-bit, 0..464)
        lda BY
        clc
        adc DY
        sta BY
        lda BY+1
        adc #0
        ldy DY
        bpl .yp
        sec
        sbc #1
.yp:    sta BY+1
        lda BY+1
        bmi .yflip
        cmp #1
        bcc .yok
        lda BY
        cmp #208                ; 464 = $01D0
        bcc .yok
.yflip: lda DY
        eor #$FF
        clc
        adc #1
        sta DY
.yok:   lda BX
        sta SPRTAB+0
        lda BX+1
        sta SPRTAB+1
        lda BY
        sta SPRTAB+2
        lda BY+1
        sta SPRTAB+3
        jmp LOOP

; ---- setup helpers ----
SID0   = $D400
SOUND:  lda #$0F
        sta SID0+$18            ; volume
        lda #$09
        sta SID0+$05            ; attack 0, decay 9
        lda #$00
        sta SID0+$06            ; sustain 0, release 0  -> a short pluck
        lda #$00
        sta SID0+$00
        lda #$4E                ; freq hi (a low tone at this clock)
        sta SID0+$01
        lda #$11                ; triangle + gate
        sta SID0+$04
        rts
TEXT:   ldx #0
.t:     lda MSG1,x
        beq .t2
        sta SCREEN+2*80+20,x
        inx
        bne .t
.t2:    ldx #0
.u:     lda MSG2,x
        beq .t3
        sta SCREEN+4*80+20,x
        inx
        bne .u
.t3:    ldx #0
.v:     lda MSG3,x
        beq .done
        sta SCREEN+57*80+2,x
        inx
        bne .v
.done:  rts
MSG1:   !text "BMC-K4510   45GS02 + VICKe + SHEILA", 0
MSG2:   !text "sky: SHEILA palette bands   ball: sprite 0, 16x16, 8 bpp, moved on vblank", 0
MSG3:   !text "text layer 0 over a SHEILA gradient  --  everything on screen is 45GS02 code talking to registers", 0

BALL:   ; 16x16 8bpp ball: index 48, shade 49 on the lower-right, 0 outside a rough circle
        ldx #0
.row:   ldy #0
.col:   ; simple diamond-ish mask: |x-8|+|y-8| <= 8  (cheap circle)
        txa
        sec
        sbc #8
        bpl .ax
        eor #$FF
        clc
        adc #1
.ax:    sta $50
        tya
        sec
        sbc #8
        bpl .ay
        eor #$FF
        clc
        adc #1
.ay:    clc
        adc $50
        cmp #9
        bcs .zero
        lda #48
        cpy #9
        bcc .put
        cpx #9
        bcc .put
        lda #49
        jmp .put
.zero:  lda #0
.put:   sta $52
        ; addr = SPRDAT + x*16 + y
        txa
        asl
        asl
        asl
        asl
        sta $54
        lda #>SPRDAT
        sta $55                 ; (no carry games: x*16 < 256)
        lda #<SPRDAT
        clc
        adc $54
        sta $54
        lda $55
        adc #0
        sta $55
        lda $52
        sta ($54),y
        iny
        cpy #16
        bne .col
        inx
        cpx #16
        bne .row
        ; sprite table entry 0
        ldx #15
        lda #0
.clr:   sta SPRTAB,x
        dex
        bpl .clr
        lda #<SPRDAT
        sta SPRTAB+4
        lda #>SPRDAT
        sta SPRTAB+5
        lda #%00000011          ; enable, 8bpp, Z=0
        sta SPRTAB+8
        lda #%00000101          ; 16x16
        sta SPRTAB+9
        lda #100
        sta BX
        lda #0
        sta BX+1
        lda #120
        sta BY
        lda #0
        sta BY+1
        lda #2
        sta DX
        lda #1
        sta DY
        lda #<SPRTAB
        sta VICKE+$0A
        lda #>SPRTAB
        sta VICKE+$0B
        lda #0
        sta VICKE+$0C
        sta VICKE+$0D
        lda #1
        sta VICKE+$0E           ; sprites on
        rts

SHEILA: ; 32 bands of 15 lines: WAIT n*15 ; MOVE BGCOL, 16+n
        ldx #0
        ldy #0                  ; list offset
        lda #0
        sta $56                 ; line counter lo
        sta $57
.band:  lda #1
        sta SHLIST,y            ; WAIT
        lda $56
        sta SHLIST+1,y
        lda $57
        sta SHLIST+2,y
        lda #0
        sta SHLIST+3,y
        lda #2
        sta SHLIST+4,y          ; MOVE
        lda #$01
        sta SHLIST+5,y          ; BGCOL
        txa
        clc
        adc #16
        sta SHLIST+6,y
        lda #0
        sta SHLIST+7,y
        tya
        clc
        adc #8
        tay
        lda $56
        clc
        adc #15
        sta $56
        lda $57
        adc #0
        sta $57
        inx
        cpx #32
        bne .band
        lda #0
        sta SHLIST+256          ; END (32 bands x 8 bytes = 256; Y would wrap)
        lda #<SHLIST
        sta VICKE+$60
        lda #>SHLIST
        sta VICKE+$61
        lda #0
        sta VICKE+$62
        sta VICKE+$63
        lda #1
        sta VICKE+$64           ; SHEILA on
        rts

CLS:    lda #<SCREEN
        sta $54
        lda #>SCREEN
        sta $55
        lda #$20
        ldx #>(80*60)
        ldy #0
.p:     sta ($54),y
        iny
        bne .p
        inc $55
        dex
        bne .p
.r:     cpy #<(80*60)
        beq .h
        sta ($54),y
        iny
        bne .r
.h:     rts

*= $FFFA
        !word $0F00
        !word RESET
        !word $0000
